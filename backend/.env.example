# Banco de dados (sobe com `docker compose up -d` na raiz do projeto)
DATABASE_URL=postgresql+asyncpg://guarda_roupa:guarda_roupa@localhost:5432/guarda_roupa
# Alembic usa driver síncrono (psycopg2) para rodar migrações
ALEMBIC_DATABASE_URL=postgresql+psycopg2://guarda_roupa:guarda_roupa@localhost:5432/guarda_roupa

# Supabase Auth — usado para validar o JWT enviado pelo app
SUPABASE_JWT_SECRET=changeme
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Ollama (Gemma 3) — sugestão de metadados das peças; precisa do modelo baixado (`ollama pull gemma3:4b`)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODELO=gemma3:4b
OLLAMA_TIMEOUT_S=30
# Orçamento total (segundos) da sugestão de look a partir de uma referência do mural
SUGESTAO_TEMPO_MAX_S=120

# Storage local (MVP). Troca para S3/Supabase Storage via app/adapters/storage_adapter.py
UPLOAD_DIR=uploads

CORS_ORIGINS=http://localhost:3000,http://localhost:8080
