# "desenvolvimento" ou "producao". Em produção a API não sobe se SUPABASE_JWT_SECRET
# estiver preenchido, se SUPABASE_URL faltar ou se CORS_ORIGINS tiver "*", http ou localhost.
AMBIENTE=desenvolvimento

# Banco de dados (sobe com `docker compose up -d` na raiz do projeto)
DATABASE_URL=postgresql+asyncpg://guarda_roupa:guarda_roupa@localhost:5432/guarda_roupa
# Alembic usa driver síncrono (psycopg2) para rodar migrações
ALEMBIC_DATABASE_URL=postgresql+psycopg2://guarda_roupa:guarda_roupa@localhost:5432/guarda_roupa

# Supabase Auth — valida o JWT enviado pelo app (E9.F1.1)
# URL da API do projeto (não a do painel): https://<ref>.supabase.co.
# As chaves públicas (ES256) são lidas de <SUPABASE_URL>/auth/v1/.well-known/jwks.json.
SUPABASE_URL=
# Só desenvolvimento: segredo dos tokens de teste (HS256) de scripts/gerar_token_teste.py.
# Em produção, deixe VAZIO — isso desliga os tokens de teste.
SUPABASE_JWT_SECRET=changeme
# Chave de serviço: só backend, nunca no app (usada a partir do Épico 10).
SUPABASE_SERVICE_KEY=

# Ollama (Gemma 3) — sugestão de metadados das peças; precisa do modelo baixado (`ollama pull gemma3:4b`)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODELO=gemma3:4b
OLLAMA_TIMEOUT_S=30
# Orçamento total (segundos) da sugestão de look a partir de uma referência do mural
SUGESTAO_TEMPO_MAX_S=120

# Storage local (MVP). Troca para S3/Supabase Storage via app/adapters/storage_adapter.py
UPLOAD_DIR=uploads

# Origens do app que podem chamar a API (o Chrome do `flutter run` usa a 8080).
# Em produção: só as URLs https do app publicado.
CORS_ORIGINS=http://localhost:8080
